<!DOCTYPE html>
<html>
<head>
    <title>Contrôle des curseurs</title>
    <style>
        body {
            background-image: url('/Users/albanearifon/Desktop/rasberry/kev.jpg');
            background-size: cover; /* Redimensionne l'image pour couvrir toute la fenêtre */
            background-repeat: no-repeat; /* Empêche la répétition de l'image */
            background-attachment: fixed; /* Fixe l'image en arrière-plan */
            background-size: 50%; /*taille image*/
        }
        

        /* Styles pour le curseur 1 (vertical) */
        #curseur1Container {
            position: absolute;
            left: 70px; 
            top: 60px; 
        }
    
        #curseur1 {
            width: 300px;
            height: 300px; 
            transform: rotate(-90deg); /* curseur vertical */
        }
        /* Styles pour le curseur 2 (horizontal) */
        #curseur2Container {
            position: absolute;
            right: 40px; 
            top: 175px; 
        }

        /* Agrandir le curseur 2 */
        #curseur2 {
            width: 300px; 
            height: 20px; 
        }
        
    </style>
</head>
<body>
    <h1>Commandes Kev</h1>
    
    
    <div id="curseur1Container">
        <input type="range" id="curseur1" min="-100" max="100" value="0">
    </div>

    <!-- Curseur 2 (horizontal) -->
    <div id="curseur2Container">
        <input type="range" id="curseur2" min="-100" max="100" value="0">
    </div>

    <script>
        
        const curseur1 = document.getElementById("curseur1");
        const curseur1Value = document.getElementById("curseur1Value");
        const initialCurseur1Value = curseur1.value; // Valeur initiale

        const curseur2 = document.getElementById("curseur2");
        const curseur2Value = document.getElementById("curseur2Value");
        const initialCurseur2Value = curseur2.value; // Valeur initiale
        
        function updateCurseurValue(curseur, valueElement) {
            valueElement.textContent = "Valeur : " + curseur.value;
        }
        

        
        // Associer un événement "input" à chaque curseur pour une mise à jour en temps réel
        curseur1.addEventListener("input", function() {
            updateCurseurValue(curseur1, curseur1Value);
        });

        curseur2.addEventListener("input", function() {
            updateCurseurValue(curseur2, curseur2Value);
        });

        // Réinitialiser les curseurs à leur valeur initiale lorsqu'ils sont relâchés 
        curseur1.addEventListener("change", function() {
            curseur1.value = initialCurseur1Value;
            updateCurseurValue(curseur1, curseur1Value);
        });

        curseur2.addEventListener("change", function() {
            curseur2.value = initialCurseur2Value;
            updateCurseurValue(curseur2, curseur2Value);
        });

        // Initialisez les valeurs affichées
        updateCurseurValue(curseur1, curseur1Value);
        updateCurseurValue(curseur2, curseur2Value);

    </script>
    
</body>
</html>
